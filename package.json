{
  "name": "cortex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @cortex/web",
    "build": "npm run build -w @cortex/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "memory": "cd services/memory && .venv\\Scripts\\python -m uvicorn app.main:app --port 8000",
    "eval": "tsx evals/run.ts",
    "eval:fast": "tsx evals/run.ts fast",
    "mock-llm": "node scripts/mock-llm.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "memory:setup": "cd services/memory && python -m venv .venv && .venv/Scripts/python -m pip install -r requirements.txt",
    "oracle:local": "node scripts/oracle-local.mjs",
    "eval:routing": "tsx evals/routing.ts",
    "eval:memory": "tsx evals/memory.ts",
    "check:auth": "node scripts/check-auth.mjs .cache",
    "check:files": "node scripts/check-files.mjs .cache",
    "check:onboarding": "node scripts/check-onboarding.mjs .cache",
    "check:errors": "node scripts/check-errors.mjs .cache",
    "check:admin": "node scripts/check-admin.mjs .cache"
  },
  "devDependencies": {
    "@next/env": "^16.4.3",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
