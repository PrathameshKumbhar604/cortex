{
  "name": "cortex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @cortex/web",
    "build": "npm run build -w @cortex/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "memory": "cd services/memory && python -m uvicorn app.main:app --port 8000 --reload",
    "eval": "tsx evals/run.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
