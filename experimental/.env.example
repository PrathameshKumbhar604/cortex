# Copy to experimental/.env.local and fill in. Never commit the real file.

# The Cortex backend (the existing Next.js app). On the same Wi-Fi as the phone: your laptop's LAN address and port.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# The same Clerk instance as the web app (the pk_test_… key from the root .env during development).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

