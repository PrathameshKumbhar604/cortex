# LLMs
PUTER_AUTH_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Connectors
# A Composio key. A Connect key (ck_, Composio "For You" → Settings) works for everyone: each user's connections are
# tagged as theirs and kept apart, up to 10 accounts per app. A project key (ak_, platform.composio.dev) has no such cap.
COMPOSIO_API_KEY=
FIRECRAWL_API_KEY=

# Memory sidecar
MEMORY_SERVICE_URL=http://localhost:8000
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_DSN=
ORACLE_WALLET_DIR=./wallet

# Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cortex

# Extra MCP servers (see mcp.config.example.json)
CORTEX_MCP_CONFIG=

# Dev only: point at scripts/mock-llm.mjs to run without keys
CORTEX_MOCK_LLM_URL=

# Sign-in (Clerk). Free: create an application at dashboard.clerk.com → API keys. Development keys give email +
# password, Google and GitHub sign-in with no further setup; production needs your own Google/GitHub OAuth apps.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Admins of this Cortex (comma-separated emails, confirmed at sign-in). Only they see the admin panel; they can make
# other accounts admins from it. When empty, nobody is an admin.
CORTEX_OWNER_EMAILS=
