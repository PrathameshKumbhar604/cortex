# LLMs
PUTER_AUTH_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Connectors
COMPOSIO_API_KEY=
FIRECRAWL_API_KEY=

# Memory sidecar
MEMORY_SERVICE_URL=http://localhost:8000
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_DSN=
ORACLE_WALLET_DIR=./wallet

# Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cortex

# Extra MCP servers (see mcp.config.example.json)
CORTEX_MCP_CONFIG=

# Dev only: point at scripts/mock-llm.mjs to run without keys
CORTEX_MOCK_LLM_URL=

# Sign-in (Clerk). Free: create an application at dashboard.clerk.com → API keys. Development keys give email +
# password, Google and GitHub sign-in with no further setup; production needs your own Google/GitHub OAuth apps.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Who may use the live apps while COMPOSIO_API_KEY is a personal ck_ key (every connected app is that key owner's).
# Comma-separated; when empty, the first account with a confirmed email is the owner (and first admin). Everyone else gets the sample workspace.
CORTEX_OWNER_EMAILS=
